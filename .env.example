# ---------------------------------------------------------------------------
# Copier vers .env.local et remplir. Ne jamais committer le fichier rempli.
#
# Générer les deux secrets propres à l'instance :
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"  # TOKEN_ENCRYPTION_KEY
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"     # CRON_SECRET
# ---------------------------------------------------------------------------

# ── Requis ─────────────────────────────────────────────────────────────────
# Sans ces variables, l'application ne démarre pas.

# Supabase → Project Settings → API. La clé `secret` ne quitte jamais le
# serveur : elle contourne les politiques RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Chiffre les jetons de rafraîchissement Spotify avant de les écrire en base.
# La perdre rend les comptes liés inutilisables : ils devront être reliés.
TOKEN_ENCRYPTION_KEY=

# Protège les routes /api/cron/*. Sans lui, n'importe qui pourrait déclencher
# les tâches de fond et épuiser le quota Spotify.
CRON_SECRET=

# Origine publique, utilisée pour construire l'URL de retour OAuth. Doit
# correspondre exactement à une Redirect URI déclarée côté Spotify.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# ── Spotify ────────────────────────────────────────────────────────────────
# https://developer.spotify.com/dashboard → Create app.
# Redirect URI à déclarer : <NEXT_PUBLIC_SITE_URL>/auth/callback
#
# À savoir : une application en mode développement est limitée à 5 comptes,
# ajoutés un par un dans Settings → User Management, et son propriétaire doit
# être Premium. Sans ces variables l'application démarre, mais l'écran de
# connexion affiche « Setup unfinished ».
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ── Optionnel ──────────────────────────────────────────────────────────────

# Moteur de recommandation par IA. Absente, l'application fonctionne : seul le
# moteur maison répond, et le choix « With AI analysis » explique son absence.
ANTHROPIC_API_KEY=

# Tags et artistes similaires. Absente, les genres se limitent à ceux de
# MusicBrainz — nettement plus pauvres.
LASTFM_API_KEY=

# MusicBrainz impose un User-Agent identifiant, avec un moyen de contact.
MUSICBRAINZ_USER_AGENT=NextTrack/0.1 ( you@example.com )

# Tâches périodiques : collecte des écoutes, enrichissement, sélection du jour.
#
#   true  → l'application les planifie elle-même. C'est ce qu'il faut sur
#           Railway, dans un conteneur, ou sur toute machine qui fait tourner
#           un processus durable.
#   false → un ordonnanceur externe appelle les routes /api/cron/*. C'est le
#           cas sur Vercel, où vercel.json s'en charge : les activer ici ferait
#           tourner chaque tâche deux fois.
ENABLE_SCHEDULER=false
